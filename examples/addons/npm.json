{
  "format_version": 1,
  "version": "1.0.0",
  "id": "npm",
  "name": "npm",
  "detect": {"files": ["package.json"], "tools": ["npm"]},
  "settings": [{"id": "script", "name": "Script", "type": "text", "default": "dev"}],
  "actions": [
    {"id": "run", "name": "Run script", "kind": "command", "executable": "npm", "args": ["run", "${setting.script}"]},
    {"id": "install", "name": "Install dependencies", "kind": "output", "executable": "npm", "args": ["install"]}
  ]
}
